# External HTTPS URL the browser and Bitwarden apps use; no trailing slash.
DOMAIN=https://vault.example.com

# IP address assigned to THIS Docker host, never the ingress proxy's IP.
# Use 127.0.0.1 only if the reverse proxy runs in the same network namespace.
BIND_IP=127.0.0.1

# Host-published ports (not public browser ports).
HTTP_PORT=8080
TLS_PORT=8443

# Briefly allow signup only from a restricted source while creating the first account.
SIGNUPS_ALLOWED=false
